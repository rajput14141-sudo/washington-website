# Public URL where users open the site. Do not include a trailing slash.
PUBLIC_ORIGIN=http://localhost
HTTP_PORT=80

# Replace with a unique random string of at least 32 characters.
JWT_KEY=replace-with-a-long-random-production-secret

# MySQL passwords used by the bundled database container.
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Bootstrap the first administrator, then set SEED_ADMIN_ENABLED=false.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password